# Private service settings. Never prefix these with VITE_ or EXPO_PUBLIC_.
# Local web speech reads these settings. The separate native SpacetimeDB voice
# module also needs its own remote environment configuration.
ELEVENLABS_API_KEY=
# Optional standalone exterior valuation service, not needed for photo analysis.
MARKETCHECK_API_KEY=
# Optional additional local frontend origins, separated by commas.
VISION_ALLOWED_ORIGINS=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_VISION_MODEL=
ELEVENLABS_VOICE_ID=
SPACETIMEDB_HOST=https://maincloud.spacetimedb.com
SPACETIMEDB_DATABASE=toyotautd-b9e7n
# Optional server token. Never copy this into a public VITE_ variable.
SPACETIMEDB_TOKEN=
