# Private service settings. Never prefix these with VITE_ or EXPO_PUBLIC_.
# ElevenLabs must also be configured in the SpacetimeDB module environment;
# placing it here alone does not configure the remote module.
ELEVENLABS_API_KEY=
# Optional standalone exterior valuation service, not needed for photo analysis.
MARKETCHECK_API_KEY=
# Optional additional local frontend origins, separated by commas.
VISION_ALLOWED_ORIGINS=
