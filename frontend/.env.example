# Public browser map key. Restrict it to your deployed origins in Geoapify.
VITE_GEOAPIFY_API_KEY=
# Local Vite proxy target for the Python vision gateway (not exposed in the browser).
VISION_PROXY_TARGET=http://127.0.0.1:8780
# Optional same-origin/reverse-proxied API path for hosted web builds.
VITE_VISION_API_BASE=/api/vision
